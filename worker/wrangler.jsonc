{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "portfolio-activity",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "vars": {
    "DEVELOPMENT": "true",
    "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
    "EXPOSE_CODING_PROJECT": "false"
  },
  "env": {
    "production": {
      "name": "portfolio-activity-production",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "vars": {
        "DEVELOPMENT": "false",
        "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
        "EXPOSE_CODING_PROJECT": "false",
        "ACTIVITY_MONITOR_ENABLED": "true"
      },
      "kv_namespaces": [
        {
          "binding": "ACTIVITY_MONITOR_STATE",
          "id": "41b0fdba488a46a392cd3764d50eb24b"
        }
      ],
      "triggers": {
        "crons": ["0 6 * * *"]
      }
    },
    "preview": {
      "name": "portfolio-activity-preview",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "vars": {
        "DEVELOPMENT": "false",
        "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
        "EXPOSE_CODING_PROJECT": "false",
        "ACTIVITY_MONITOR_ENABLED": "false"
      },
      "kv_namespaces": [],
      "triggers": {
        "crons": []
      }
    }
  }
}
