{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "portfolio-activity",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "vars": {
    "DEVELOPMENT": "true",
    "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
    "EXPOSE_CODING_PROJECT": "false"
  },
  "env": {
    "production": {
      "name": "portfolio-activity-production",
      "vars": {
        "DEVELOPMENT": "false",
        "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
        "EXPOSE_CODING_PROJECT": "false"
      }
    },
    "preview": {
      "name": "portfolio-activity-preview",
      "vars": {
        "DEVELOPMENT": "false",
        "ALLOWED_ORIGINS": "https://hugojava.dev,https://hugodotnet.dev",
        "EXPOSE_CODING_PROJECT": "false"
      }
    }
  }
}
